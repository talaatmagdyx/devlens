# DevLens configuration. Nothing here is loaded automatically: export these in
# your shell, or let Docker Compose inject them.
#
# Every optional capability below is OFF unless its variable is set. That is the
# state DevLens ships in and the state its tests run in.

# --------------------------------------------------------------------------- #
# Required for Jira + git modes (ticket, review, implement)
# --------------------------------------------------------------------------- #
DEVLENS_JIRA_URL=https://your-team.atlassian.net
DEVLENS_JIRA_EMAIL=
DEVLENS_JIRA_TOKEN=
DEVLENS_GITHUB_TOKEN=
# Allowlists. A repository or Jira project that is not listed is refused with a
# 403, at the tool boundary and again at the write boundary.
DEVLENS_REPOSITORIES=your-org/your-repo
DEVLENS_JIRA_PROJECTS=DEV

# Bitbucket Cloud instead of GitHub:
# DEVLENS_GIT_PROVIDER=bitbucket_cloud
# DEVLENS_BITBUCKET_EMAIL=you@example.com
# DEVLENS_BITBUCKET_TOKEN=
# DEVLENS_REPOSITORIES=your-workspace/your-repo

# Multiple projects: a TOML file replaces every single-project variable above.
# Credentials are referenced by variable NAME in that file, never written into it.
# DEVLENS_CONFIG=/absolute/path/to/devlens.toml
# PAYMENTS_JIRA_TOKEN=
# PAYMENTS_BITBUCKET_TOKEN=

# --------------------------------------------------------------------------- #
# Local paths and storage
# --------------------------------------------------------------------------- #
# The root that `analyze` and path-based modes are confined to. Defaults to the
# working directory — not the whole host. Set it to "/" to opt out explicitly.
# DEVLENS_ANALYZE_ROOT=/absolute/path/allowed/for/analyze
# # Finished runs to keep in the job database. 0 keeps everything.
# DEVLENS_JOB_HISTORY=5000

DEVLENS_JOBS_DB=.devlens-jobs.sqlite
# Compiled UI location. Only needed when serving a build from elsewhere.
# DEVLENS_UI_DIR=/absolute/path/to/web/dist

# --------------------------------------------------------------------------- #
# Operator UI sign-in (optional)
# --------------------------------------------------------------------------- #
# One shared password for one operator on a loopback interface. Short passwords
# are accepted but reported as weak in /settings. This is not an authentication
# boundary for a shared network — use devlens.app.saas:app for that.
# DEVLENS_UI_PASSWORD=
# DEVLENS_SESSION_SECONDS=28800
# Expected Origin for state-changing requests. Defaults to the request's Host.
# DEVLENS_PUBLIC_ORIGIN=https://devlens.internal

# --------------------------------------------------------------------------- #
# Audit trail (optional)
# --------------------------------------------------------------------------- #
# Append-only JSONL, secrets redacted recursively, rotated at 8 MB. Append-
# oriented, not tamper-proof: anyone who can write the file can rewrite it.
# DEVLENS_AUDIT_LOG=/var/log/devlens/audit.jsonl

# --------------------------------------------------------------------------- #
# Language model (optional) — capability: llm, screenshot_analysis
# --------------------------------------------------------------------------- #
# Selection is explicit. A vendor key that happens to exist in the environment
# does NOT enable a model; only this variable does.
# DEVLENS_LLM_PROVIDER=openai|claude|codex|claude_code|codex_cli
# DEVLENS_LLM_API_KEY=
# DEVLENS_LLM_BASE_URL=https://api.openai.com/v1     # must be HTTPS unless loopback
# DEVLENS_LLM_MODEL=gpt-4o-mini
# DEVLENS_VISION_MODEL=gpt-4o-mini
# Per-process ceilings:
# DEVLENS_LLM_MAX_CALLS=32
# DEVLENS_LLM_MAX_PROMPT_CHARS=24000
#
# Anthropic:
# DEVLENS_ANTHROPIC_API_KEY=
# DEVLENS_CLAUDE_MODEL=claude-sonnet-4-5
# Codex:
# DEVLENS_CODEX_API_KEY=
# DEVLENS_CODEX_MODEL=gpt-5-codex
#
# OAuth instead of an API key. DevLens reads a CLI credential cache ONLY when
# DEVLENS_LLM_OAUTH=1, or when you name the file explicitly.
# DEVLENS_LLM_OAUTH=1
# DEVLENS_CLAUDE_OAUTH_TOKEN=
# ANTHROPIC_AUTH_TOKEN=
# DEVLENS_CLAUDE_CREDENTIALS=/absolute/path/to/credentials.json
# DEVLENS_CODEX_OAUTH_TOKEN=
# CODEX_ACCESS_TOKEN=
# DEVLENS_CODEX_ACCOUNT_ID=
# DEVLENS_CODEX_AUTH=/absolute/path/to/auth.json
#
# Alternate API endpoints, for a gateway or a proxy. Each must be HTTPS unless
# it is loopback.
# DEVLENS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEVLENS_CODEX_BASE_URL=https://api.openai.com/v1
# DEVLENS_CODEX_OAUTH_BASE_URL=https://chatgpt.com/backend-api/codex
# DEVLENS_CODEX_ORIGINATOR=devlens
# Only needed when a Claude credentials file carries no client id of its own.
# DEVLENS_CLAUDE_OAUTH_CLIENT_ID=

# --------------------------------------------------------------------------- #
# Live telemetry (optional) — capability: observability_provider
# --------------------------------------------------------------------------- #
# Each URL must be HTTPS unless it is loopback. An unreachable provider yields
# UNKNOWN evidence; it never becomes support for a hypothesis.
# DEVLENS_LOKI_URL=
# DEVLENS_LOKI_TOKEN=
# DEVLENS_PROM_URL=
# DEVLENS_PROM_TOKEN=
# DEVLENS_TEMPO_URL=
# DEVLENS_TEMPO_TOKEN=
# SELECT only, through a gateway whose credential must also be a read-only role.
# DEVLENS_SQL_URL=
# DEVLENS_SQL_TOKEN=

# --------------------------------------------------------------------------- #
# Remote writes (optional) — capability: git_writeback, jira_writeback
# --------------------------------------------------------------------------- #
# Still requires an operator to approve a specific proposal. Merge, deploy and
# release are refused whatever this is set to.
# DEVLENS_ALLOW_WRITES=0

# --------------------------------------------------------------------------- #
# Executing a repository's own tests (optional)
# --------------------------------------------------------------------------- #
# This runs arbitrary code from the repository under inspection. The child gets
# an allowlisted environment (no DevLens credentials) and hard resource limits,
# and is confined by a container runtime when one is available.
# DEVLENS_ALLOW_REPO_TESTS=0
# Which container runtime confines the run. "none" accepts process limits only.
# DEVLENS_SANDBOX_RUNTIME=podman|docker|none
# The image the container runtime runs the repository's tests in.
# DEVLENS_SANDBOX_IMAGE=python:3.12-slim
# Running repository code as root with no container runtime is REFUSED, because
# process limits do not constrain a root user. Set this only on a host you are
# willing to lose, such as a disposable CI container; it is recorded in every
# report's limitations.
# DEVLENS_ALLOW_ROOT_REPO_TESTS=0
