DEVLENS_JIRA_URL=https://your-team.atlassian.net
DEVLENS_JIRA_EMAIL=
DEVLENS_JIRA_TOKEN=
DEVLENS_GITHUB_TOKEN=
DEVLENS_REPOSITORIES=your-org/your-repo
DEVLENS_JIRA_PROJECTS=DEV

# Single-project Bitbucket Cloud alternative:
# DEVLENS_GIT_PROVIDER=bitbucket_cloud
# DEVLENS_BITBUCKET_EMAIL=you@example.com
# DEVLENS_BITBUCKET_TOKEN=
# DEVLENS_REPOSITORIES=your-workspace/your-repo

# Multiple projects: use TOML instead of the single-project variables above.
# DEVLENS_CONFIG=/absolute/path/to/devlens.toml
# PAYMENTS_JIRA_TOKEN=
# PAYMENTS_BITBUCKET_TOKEN=
# PLATFORM_JIRA_TOKEN=
# PLATFORM_GITHUB_TOKEN=
