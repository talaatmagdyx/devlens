# Copy to .env before `docker compose up --build`. Compose injects this file;
# DevLens never loads it on its own.
#
# See .env.example for the full, commented list. Everything optional is off.

DEVLENS_JIRA_URL=https://your-team.atlassian.net
DEVLENS_JIRA_EMAIL=
DEVLENS_JIRA_TOKEN=
DEVLENS_GITHUB_TOKEN=
DEVLENS_REPOSITORIES=your-org/your-repo
DEVLENS_JIRA_PROJECTS=DEV

# DEVLENS_JOBS_DB and DEVLENS_ANALYZE_ROOT are set by Compose; do not override
# them here unless you also change the volumes.

# Sign-in for the UI. Set this even on loopback if anyone else uses the machine.
# DEVLENS_UI_PASSWORD=

# Optional capabilities, each off until set.
# DEVLENS_LLM_PROVIDER=openai
# DEVLENS_LLM_API_KEY=
# DEVLENS_ALLOW_WRITES=0
# DEVLENS_ALLOW_REPO_TESTS=0
# DEVLENS_LOKI_URL=
# DEVLENS_PROM_URL=
# DEVLENS_TEMPO_URL=
# DEVLENS_SQL_URL=
# DEVLENS_AUDIT_LOG=/data/audit.jsonl
